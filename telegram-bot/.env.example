TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_KEY=your_api_key_here

# UNIVERSAL PROVIDER CONFIGURATION OPTIONS:
# Option 1: Custom Base URL (e.g. OpenRouter, Groq, DeepSeek, vLLM, or Local Ollama/LM Studio)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# Option 2: Custom API Key (use "local" for offline Ollama/LM Studio)
# OPENAI_API_KEY=sk-or-v1-...

# Option 3: Custom Model Name (e.g. qwen3.7-plus, gemini-2.5-flash, qwen2.5:7b)
# OPENAI_MODEL=gemini-2.5-flash
