{
  "name": "@grizlizora/holy-bible-mcp",
  "version": "2.0.0",
  "description": "Universal Multilingual Bible MCP Server (800+ languages, 11.9M verses, 100% offline, zero-latency FTS5)",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "holy-bible-mcp": "build/index.js",
    "@grizlizora/holy-bible-mcp": "build/index.js"
  },
  "files": [
    "build",
    "data/directives.sqlite",
    "mcp-manifest.json"
  ],
  "scripts": {
    "build": "rm -rf build && tsc && cp src/data/osis_dictionary.json build/data/osis_dictionary.json 2>/dev/null || true",
    "start": "node build/index.js",
    "db:download": "node build/index.js download-db",
    "db:clean": "node build/index.js delete-db",
    "db:status": "node build/index.js db-status",
    "db:verify": "node build/index.js verify-db"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bible",
    "bible-mcp",
    "ai-bible",
    "multilingual",
    "theology",
    "sqlite-fts5",
    "antigravity",
    "claude-desktop",
    "cursor"
  ],
  "author": "Antigravity Team & Holy Project",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "diff": "^9.0.0",
    "graphology": "^0.26.0",
    "lru-cache": "^11.5.2",
    "minisearch": "^7.2.0",
    "piscina": "^5.3.0",
    "sqlite-vec": "^0.1.6",
    "sqlite3": "^5.1.7",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/sqlite3": "^3.1.3",
    "typescript": "^5.4.5"
  }
}
