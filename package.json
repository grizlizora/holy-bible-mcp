{
  "name": "@grizlizora/holy-bible-mcp",
  "version": "2.0.0",
  "description": "Universal Multilingual Bible MCP Server (800+ languages, 11.9M verses, 100% offline, zero-latency FTS5)",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "holy-bible-mcp": "build/index.js",
    "@grizlizora/holy-bible-mcp": "build/index.js"
  },
  "files": [
    "build",
    "data/directives.sqlite",
    "mcp-manifest.json"
  ],
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "rm -rf build && npx -y -p typescript tsc && cp src/data/osis_dictionary.json build/data/osis_dictionary.json 2>/dev/null || true",
    "build:all": "npm run build && npm --prefix client run build",
    "start": "node build/index.js",
    "start:web": "npm --prefix client run start",
    "test": "npx tsx scripts/verify_v2.ts",
    "test:stress": "npx tsx scripts/stress_test_mcp.ts",
    "test:local": "npx tsx scripts/test_mcp_locally.ts",
    "seed:directives": "npx tsx scripts/seed_directives_db.ts",
    "migrate:directives": "npx tsx scripts/migrate_sqlite_directives.ts",
    "migrate:osis": "npx tsx scripts/migrate_osis_to_sqlite.ts",
    "db:download": "node build/index.js download-db",
    "db:clean": "node build/index.js delete-db",
    "db:status": "node build/index.js db-status",
    "db:verify": "node build/index.js verify-db"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bible",
    "bible-mcp",
    "ai-bible",
    "multilingual",
    "theology",
    "sqlite-fts5",
    "antigravity",
    "claude-desktop",
    "cursor"
  ],
  "author": "Antigravity Team & Holy Project",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "sqlite-vec": "^0.1.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sqlite3": "^3.1.3",
    "typescript": "^5.4.5"
  }
}
