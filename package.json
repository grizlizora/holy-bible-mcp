{
  "name": "@grizlizora/holy-bible-mcp",
  "version": "2.0.0",
  "description": "Universal Multilingual Bible MCP Server (800+ languages, 11.9M verses, 100% offline, zero-latency FTS5)",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "holy-bible-mcp": "build/index.js",
    "@grizlizora/holy-bible-mcp": "build/index.js"
  },
  "files": [
    "build",
    "data/directives.sqlite",
    "mcp-manifest.json"
  ],
  "scripts": {
    "build": "rm -rf build && npx -y -p typescript tsc && cp src/data/osis_dictionary.json build/data/osis_dictionary.json 2>/dev/null || true",
    "start": "node build/index.js",
    "test": "node scripts/verify_v2.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bible",
    "bible-mcp",
    "ai-bible",
    "multilingual",
    "theology",
    "sqlite-fts5",
    "antigravity",
    "claude-desktop",
    "cursor"
  ],
  "author": "Antigravity Team & Holy Project",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "sqlite-vec": "^0.1.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sqlite3": "^3.1.3",
    "typescript": "^5.4.5"
  }
}
